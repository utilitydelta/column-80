# Context docs. These carry client material and were protected only by a GLOBAL
# ignore (~/.config/git/ignore), which does not travel with the repo: on any other
# machine `git add -A` would have staged them.
.index.md

# native build tree; the packaged binaries land in native/bin/<target>/ from CI
native/build/
native/bin/
native/build.log
native/configure.log

# `bundleCore` writes `test/.<tag>.entry.ts` and `test/.<tag>.bundle.cjs` while a
# blind or rig module is loaded, and removes them in `cleanup()`. A run that is
# killed, or a `git add -A` from a second agent while one is in flight, leaves
# them staged. They are generated; nothing should ever commit them.
test/.*.entry.ts
test/.*.bundle.cjs
